{
  "name": "command-center-sdk-repository",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "workspaces": [
    "command-center-sdk",
    "command-center-ai"
  ],
  "scripts": {
    "boundaries:check": "node scripts/check-package-boundaries.mjs",
    "boundaries:test": "node --test scripts/check-package-boundaries.node.mjs",
    "direction:check": "node scripts/check-package-direction.mjs",
    "direction:test": "node --test scripts/check-package-direction.node.mjs",
    "public-packages:validate": "node scripts/validate-public-packages.mjs",
    "packages:check": "node scripts/run-public-package-scripts.mjs check build size:check",
    "packages:test": "node scripts/run-public-package-scripts.mjs test",
    "examples:check": "tsc -p examples/sdk-consumer-fixture/tsconfig.json --noEmit && tsc -p examples/command-center-ai-consumer-fixture/tsconfig.json --noEmit && tsc -p examples/static-site-vite-fastapi/tsconfig.json --noEmit && node --test examples/static-site-vite-fastapi/transport.node.mjs",
    "sdk:build": "npm --workspace @dev-mainsequence/command-center-sdk run build && npm --workspace @dev-mainsequence/command-center-sdk run size:check",
    "sdk:check": "npm --workspace @dev-mainsequence/command-center-sdk run check",
    "sdk:test": "npm --workspace @dev-mainsequence/command-center-sdk run test",
    "chat:check": "npm --workspace @dev-mainsequence/command-center-ai run check",
    "chat:test": "npm --workspace @dev-mainsequence/command-center-ai run test",
    "chat:build": "npm --workspace @dev-mainsequence/command-center-ai run build",
    "chat:dev": "npm --workspace @dev-mainsequence/command-center-ai run dev",
    "check": "npm run boundaries:check && npm run boundaries:test && npm run direction:check && npm run direction:test && npm run public-packages:validate && npm run packages:check && npm run examples:check",
    "build": "npm run check",
    "test": "npm run packages:test",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm --prefix docs-site run build",
    "docs:serve": "npm --prefix docs-site run serve"
  }
}
