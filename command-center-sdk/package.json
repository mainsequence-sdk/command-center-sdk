{
  "name": "@dev-mainsequence/command-center-sdk",
  "version": "0.5.6",
  "private": false,
  "description": "The framework-neutral SDK for building Command Center-compatible resource applications, navigation, layouts, themes, feedback, and embeds.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mainsequence-sdk/command-center-sdk.git",
    "directory": "command-center-sdk"
  },
  "sideEffects": [
    "*.css",
    "theme/*.css"
  ],
  "files": [
    "agent_scaffold",
    "cli",
    "contracts",
    "dist",
    "docs",
    "styles.css",
    "theme",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "command-center-sdk": "./cli/command-center-sdk.mjs"
  },
  "style": "./styles.css",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./contracts/manifest.json": "./contracts/manifest.json",
    "./contracts/schemas/*": "./contracts/schemas/*",
    "./contracts/fixtures/valid/*": "./contracts/fixtures/valid/*",
    "./contracts/fixtures/invalid/*": "./contracts/fixtures/invalid/*",
    "./embed": {
      "types": "./dist/embed/index.d.ts",
      "import": "./dist/embed/index.js"
    },
    "./embed/react": {
      "types": "./dist/embed/react.d.ts",
      "import": "./dist/embed/react.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "import": "./dist/feedback/index.js"
    },
    "./controls": {
      "types": "./dist/controls/index.d.ts",
      "import": "./dist/controls/index.js"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "import": "./dist/navigation/index.js"
    },
    "./navigation/testing": {
      "types": "./dist/navigation/testing/index.d.ts",
      "import": "./dist/navigation/testing/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./layout/testing": {
      "types": "./dist/layout/testing/index.d.ts",
      "import": "./dist/layout/testing/index.js"
    },
    "./resource": {
      "types": "./dist/resource/index.d.ts",
      "import": "./dist/resource/index.js"
    },
    "./resource/react": {
      "types": "./dist/resource/react/index.d.ts",
      "import": "./dist/resource/react/index.js"
    },
    "./views": {
      "types": "./dist/views/index.d.ts",
      "import": "./dist/views/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./theme/data-viz": {
      "types": "./dist/theme/chart-palettes.d.ts",
      "import": "./dist/theme/chart-palettes.js"
    },
    "./theme/presets": {
      "types": "./dist/theme/presets/index.d.ts",
      "import": "./dist/theme/presets/index.js"
    },
    "./theme/ag-grid.css": "./theme/ag-grid.css",
    "./theme/fonts.css": "./theme/fonts.css",
    "./theme/markdown.css": "./theme/markdown.css",
    "./theme/styles.css": "./theme/styles.css",
    "./theme/tailwind.css": "./theme/tailwind.css",
    "./theme/utilities.css": "./theme/utilities.css",
    "./tailwind.css": "./theme/tailwind.css",
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ../scripts/clean-sdk-dist.mjs && tsc -p tsconfig.json",
    "size:check": "node ../scripts/check-package-size.mjs dist/index.js 10000 && node ../scripts/check-package-size.mjs dist/feedback/components.js 25000 && node ../scripts/check-package-size.mjs dist/controls/components.js 20000 && node ../scripts/check-package-size.mjs dist/layout/components.js 20000 && node ../scripts/check-package-size.mjs dist/layout/testing/index.js 30000 && node ../scripts/check-package-size.mjs dist/navigation/testing/index.js 12000 && node ../scripts/check-package-size.mjs dist/views/ResourceListPage.js 50000 && node ../scripts/check-package-size.mjs dist/views/ResourceSearch.js 25000 && node ../scripts/check-package-size.mjs dist/views/ResourcePagination.js 25000",
    "check": "npm run theme:audit && tsc -p tsconfig.json --noEmit && tsc -p tests/types/tsconfig.json",
    "theme:audit": "node cli/command-center-sdk.mjs theme audit --path styles.css",
    "test": "vitest run && node --test tests/cli/*.node.mjs",
    "test:browser": "npm run build && playwright test --config playwright.config.ts",
    "test:package-smoke": "node tests/cli/packed-consumer-smoke.mjs",
    "prepack": "npm run build",
    "postinstall": "node ./cli/postinstall.mjs"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "lucide-react": "^0.500.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.20.0",
    "jsdom": "^29.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.5"
  }
}
