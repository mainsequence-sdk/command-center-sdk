{
  "name": "@dev-mainsequence/chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "boundary": "node scripts/check-boundary.mjs",
    "check": "node scripts/check-boundary.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit && tsc -p standalone/tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "build:standalone": "vite build"
  },
  "dependencies": {
    "@assistant-ui/core": "^0.1.13",
    "@assistant-ui/react": "^0.12.19",
    "@assistant-ui/store": "^0.2.6",
    "assistant-stream": "^0.3.10",
    "lucide-react": "^0.500.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "@dev-mainsequence/command-center-sdk": "^0.5.0",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@dev-mainsequence/command-center-sdk": "^0.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.5"
  }
}
